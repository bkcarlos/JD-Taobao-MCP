# 默认弹出可见浏览器，便于你自己扫码、登录和处理验证码。
PLAYWRIGHT_HEADLESS=false

# 留空时使用 Playwright 自带 Chromium；Windows 也可填 msedge 或 chrome。
BROWSER_CHANNEL=
BROWSER_EXECUTABLE_PATH=
JD_BROWSER_EXECUTABLE_PATH=
TAOBAO_BROWSER_EXECUTABLE_PATH=
TAOBAO_SEARCH_MODE=mobile

# 独立浏览器资料目录。不要指向你日常 Chrome/Edge 的默认用户目录。
BROWSER_PROFILE_DIR=~/.jd-taobao-browser-mcp/browser-profile
PLAYWRIGHT_BROWSERS_PATH=.ms-playwright

NAVIGATION_TIMEOUT_MS=45000
ACTION_TIMEOUT_MS=15000
ACTION_DELAY_MS=700
SLOW_MO_MS=80
MAX_SEARCH_RESULTS=30

# HTTP 模式必填：生成至少 32 个可见 ASCII 字符的随机令牌，保密保存。
# stdio 模式不需要此令牌。不要把真实令牌写入此示例文件。
MCP_HTTP_TOKEN=
MCP_HTTP_PORT=8000
# Docker Compose 在容器内部覆盖为 0.0.0.0；宿主机端口仍只映射到回环地址。
MCP_HTTP_HOST=127.0.0.1
# Optional comma-separated exact service Host values, e.g. shopping-mcp:8000. No wildcards.
MCP_HTTP_EXTRA_HOSTS=

# 可选代理，例如 http://127.0.0.1:7897
PROXY=

# Optional private human login page. HTTPS except for a local SSH tunnel.
# LOGIN_PUBLIC_URL=https://shopping.example.test/login
LOGIN_PUBLIC_URL=
