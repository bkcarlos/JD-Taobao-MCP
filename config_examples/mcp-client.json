{
  "mcpServers": {
    "jd-taobao-browser": {
      "command": "<PROJECT_DIR>\\.venv\\Scripts\\python.exe",
      "args": [
        "<PROJECT_DIR>\\server.py"
      ],
      "env": {
        "PLAYWRIGHT_HEADLESS": "false",
        "PLAYWRIGHT_BROWSERS_PATH": ".ms-playwright",
        "BROWSER_PROFILE_DIR": ".tmp/browser-profile",
        "TAOBAO_SEARCH_MODE": "mobile"
      }
    }
  }
}
